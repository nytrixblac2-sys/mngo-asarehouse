# Copy this file to .env and fill in real values from your Supabase project.
# Never commit .env — it's gitignored.

# Supabase project settings -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings -> Settings -> Database -> Connection string
# Pooled (pgbouncer, port 6543) — used by the app at runtime.
DATABASE_URL=
# Direct (port 5432) — used for migrations, which pgbouncer can't run.
DIRECT_URL=

# https://resend.com/api-keys — owner invite emails, payment confirmations.
RESEND_API_KEY=

# Comma-separated emails allowed to approve/reject workspace signups at
# /admin. Not a workspace Role — a platform admin belongs to no workspace.
PLATFORM_ADMIN_EMAILS=

# HMAC key for signing the guest /track session cookie (lib/guest-session.ts).
# Server-only, never sent to the client. Independent from
# SUPABASE_SERVICE_ROLE_KEY on purpose — falls back to it if unset, but set
# this explicitly so guest-session signing can be rotated without touching
# admin DB access. Generate with: openssl rand -base64 32
GUEST_SESSION_SECRET=
