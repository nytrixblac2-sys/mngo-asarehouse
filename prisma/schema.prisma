// MNGO database schema — see context/02-architecture-context.md ("Storage
// Model", "Auth and Access Control Model", "Financial Calculation Model")
// and context/01-project-overview.md for the product model this encodes.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────

/// context/01-project-overview.md "Authentication and Roles".
/// Team Member is V2 (out of scope) and intentionally omitted.
enum Role {
  ACCOUNT_OWNER
  CO_MANAGER
  PROPERTY_OWNER
}

/// Resolves Open Question 7 ("how does a new Account Owner sign up and
/// create a workspace"). A workspace is created PENDING at public signup
/// (app/signup) and stays inaccessible — the (app) layout blocks every
/// role — until a platform admin (lib/admin.ts, env-allow-listed emails,
/// not a workspace Role) approves it via /admin. Keeps the "nothing exists
/// unless someone specific created it on purpose" model intact even with
/// public signup: an approval gate, not an open door.
enum WorkspaceStatus {
  PENDING
  ACTIVE
  REJECTED
}

/// GHS and EUR only — context/02-architecture-context.md invariant #2:
/// GHS and EUR balances are never mixed, converted, or aggregated.
enum Currency {
  GHS
  EUR
}

/// RENTAL is the original Oak & Co.-style short-term rental product (owner/
/// operations/management income splits, free-typed booking amounts). HOSTEL
/// is Escape3Points-style: fixed-price rooms, food & beverage ordering, no
/// income splits, guest self-service booking/tracking. Drives which nav
/// items and screens render — see lib/nav.ts.
enum WorkspaceType {
  RENTAL
  HOSTEL
}

enum BookingSource {
  AIRBNB
  LOCAL
  /// Guest self-service booking via the public /book/[slug] page — as
  /// opposed to LOCAL, which stays a staff-entered walk-in.
  WEBSITE
}

enum BookingStatus {
  EXPECTED
  CONFIRMED
}

/// context/02-architecture-context.md "Financial Calculation Model" uses the
/// generic term "management", not the Oak & Co. brand name — MNGO is a
/// reusable product and Oak & Co. is one reference-implementation workspace.
enum ExpenseCategory {
  OWNERS
  OPERATIONS
  MANAGEMENT
}

enum ScheduleType {
  CLEANING
  REPAIR
  SUPERVISION
  TRAINING
}

enum IssueType {
  GUEST_COMPLAINT
  MAINTENANCE
  NOTE
  /// Auto-created when a HOSTEL guest checks out (app/api/bookings/[id]/checkout)
  /// — "{Room} needs cleaning after checkout." Tied to the room via Issue.roomId.
  ROOM_DIRTY
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

/// Which physical station prepares/fulfills a MenuItem — explicit rather
/// than inferred from the free-text `category` (too fragile once staff
/// add arbitrary categories). Drives which of the Kitchen/Bar/Shop/
/// Experiences screens an order's items show up on. SHOP and EXPERIENCE
/// were added alongside KITCHEN/BAR (Architecture Decision 91) — same
/// fulfillment-ticket mechanism, just for gift-shop purchases and bookable
/// guest experiences instead of food and drink.
enum MenuStation {
  KITCHEN
  BAR
  SHOP
  EXPERIENCE
}

/// How a guest paid at checkout (app/api/bookings/[id]/checkout) — HOSTEL
/// workspaces only, no online payment processor integration.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOMO
  CARD
}

// ── Core tenancy ─────────────────────────────────────────────────────────

/// Every workspace has exactly one Account Owner.
/// context/02-architecture-context.md "Auth and Access Control Model".
/// `accountOwnerId` is nullable to break the circular FK with `User.workspaceId`
/// (both tables reference each other): create the Workspace first, then the
/// owner User with that workspaceId, then set accountOwnerId. The API layer
/// enforces that every workspace has exactly one owner once bootstrap
/// completes — it is never left null after creation finishes.
model Workspace {
  id                String          @id @default(uuid()) @db.Uuid
  name              String
  /// URL-safe unique handle, e.g. "escape3points" — used for the public
  /// booking page (/book/[slug]). Generated from name at creation time.
  slug              String          @unique
  accountOwnerId    String?         @unique @db.Uuid
  /// See WorkspaceType doc comment — RENTAL (default) vs HOSTEL changes
  /// which nav items/screens render (lib/nav.ts) and whether income-split
  /// financials apply.
  type              WorkspaceType   @default(RENTAL)
  /// See WorkspaceStatus doc comment — gates all (app) access until a
  /// platform admin approves the signup.
  status            WorkspaceStatus @default(PENDING)
  /// Manual paid/unpaid flag, admin-toggled from /admin — no payment
  /// processor integration for V1 (billing handled outside MNGO).
  paid              Boolean         @default(false)
  /// bcrypt hash of the owner-set PIN gating a menu item's price change —
  /// never the plaintext, never sent to the client. Null until the owner
  /// sets one via ProfileModal's Security section, available for every
  /// workspace type since Architecture Decision 93 (originally
  /// HOSTEL-only, per Architecture Decision 79). Booking/order deletion
  /// used to require this too, but moved to a pending-request/approval
  /// flow instead (Architecture Decision 99) — see Booking/Order's
  /// deleteRequestedAt/deleteRequestedBy doc comments. See lib/workspace-pin.ts.
  actionPinHash     String?
  /// Consecutive incorrect PIN attempts since the last success (or last
  /// lockout) — resets to 0 on a correct guess. Paired with pinLockedUntil
  /// so a stolen/shared staff session can't script through all 10,000
  /// 4-digit combinations in minutes; see lib/workspace-pin.ts.
  pinFailedAttempts Int             @default(0)
  /// Set once pinFailedAttempts hits the lockout threshold; verifyWorkspacePin
  /// refuses every attempt (even a correct one) until this passes.
  pinLockedUntil    DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  accountOwner User?          @relation("WorkspaceAccountOwner", fields: [accountOwnerId], references: [id])
  users        User[]         @relation("WorkspaceUsers")
  properties   Property[]
  bookings     Booking[]
  expenses     Expense[]
  manualIncome ManualIncome[]
  schedules    Schedule[]
  issues       Issue[]
  teamMembers  TeamMember[]
  rooms        Room[]
  menuItems    MenuItem[]
  orders       Order[]
}

/// App-level user profile. `authId` links to the Supabase Auth user
/// (auth.users.id) — Supabase Auth owns credentials; this table owns role
/// and workspace membership.
model User {
  id                 String   @id @default(uuid()) @db.Uuid
  authId             String   @unique @db.Uuid
  workspaceId        String   @db.Uuid
  name               String
  email              String   @unique
  role               Role
  /// True only for a user still on their manager-issued one-time invite
  /// password (app/api/users/route.ts) — the (app) layout redirects them to
  /// /change-password until they set their own, so a handed-over temporary
  /// password can't linger as someone's permanent credential indefinitely.
  /// False for the Account Owner (chooses their own password at signup) and
  /// for everyone once they've changed it.
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace      Workspace      @relation("WorkspaceUsers", fields: [workspaceId], references: [id], onDelete: Cascade)
  ownedWorkspace Workspace?     @relation("WorkspaceAccountOwner")
  properties     UserProperty[]

  @@index([workspaceId])
}

/// Scopes a PROPERTY_OWNER role user to specific properties.
/// context/02-architecture-context.md "Auth and Access Control Model".
model UserProperty {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  propertyId String @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
}

// ── Properties ───────────────────────────────────────────────────────────

/// context/02-architecture-context.md "Property Theming Model" and
/// "Financial Calculation Model". `allocation` shape:
/// { GHS?: { owners, operations, management }, EUR?: { owners, operations, management } }
/// (percentages, must sum to 100 per currency — enforced at the API layer).
/// `prevBalanceGhs` / `prevBalanceEur` shape: { owners: number, management: number }.
model Property {
  id             String     @id @default(uuid()) @db.Uuid
  workspaceId    String     @db.Uuid
  name           String
  color          String     @default("#111111")
  rooms          String[]   @default([])
  facilities     String[]   @default([])
  currencies     Currency[] @default([GHS])
  allocation     Json
  prevBalanceGhs Json
  prevBalanceEur Json
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owners       UserProperty[]
  bookings     Booking[]
  expenses     Expense[]
  manualIncome ManualIncome[]
  schedules    Schedule[]
  issues       Issue[]
  hostelRooms  Room[]

  @@index([workspaceId])
}

// ── Bookings ─────────────────────────────────────────────────────────────

/// context/01-project-overview.md "Bookings". `paidAt` is set server-side
/// only at confirmation time — context/02-architecture-context.md invariant #4.
/// HOSTEL-only fields (roomId, passportNumber, guestEmail, guestPhone,
/// bookingCode, checkedOutAt) are nullable and unused by RENTAL workspaces —
/// reusing this model (rather than a parallel one) keeps the existing
/// calendar/confirm/paidAt machinery working for room bookings for free.
model Booking {
  id                String         @id @default(uuid()) @db.Uuid
  workspaceId       String         @db.Uuid
  propertyId        String         @db.Uuid
  guest             String
  checkIn           DateTime       @db.Date
  checkOut          DateTime       @db.Date
  amount            Decimal        @db.Decimal(10, 2)
  currency          Currency
  source            BookingSource
  status            BookingStatus  @default(EXPECTED)
  paidAt            DateTime?      @db.Date
  /// HOSTEL only, below this line.
  roomId            String?        @db.Uuid
  passportNumber    String?
  guestEmail        String?
  guestPhone        String?
  /// Guest-facing lookup code for the public /track page — combined with
  /// guest name, this is the guest's entire "login." Unique so a code alone
  /// unambiguously identifies one booking.
  bookingCode       String?        @unique
  /// Server-set only when staff mark the guest checked out — same pattern
  /// as paidAt. Gates receipt availability and guest ordering.
  checkedOutAt      DateTime?
  /// How the guest paid, selected at checkout. Null until checkout.
  paymentMethod     PaymentMethod?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  /// Soft-deletable — same pattern as Order, applied to every workspace
  /// (Architecture Decision 93). Deleting clears nothing — the row stays
  /// exactly as it was, just hidden from normal views and excluded from
  /// every calculation, so it can be restored intact.
  deletedAt         DateTime?
  deletedBy         String?
  deleteReason      String?
  /// Replaces PIN-gating for deletion (Architecture Decision 99) — a
  /// CO_MANAGER's delete no longer needs a shared PIN, it becomes a
  /// pending request here instead: deletedAt stays null, these two are
  /// set, and the booking stays fully active/visible everywhere until the
  /// ACCOUNT_OWNER approves it (which finalizes deletedAt/deletedBy from
  /// these, then clears them) or rejects it (just clears them, no delete).
  /// ACCOUNT_OWNER's own deletes are still immediate — they're already
  /// the approver, there's no one else to ask. deleteReason above is
  /// shared by both the pending request and the final deletion, since
  /// there's only ever one reason per request cycle.
  deleteRequestedAt DateTime?
  deleteRequestedBy String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property  Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room      Room?     @relation(fields: [roomId], references: [id])
  orders    Order[]

  @@index([workspaceId])
  @@index([propertyId])
  @@index([roomId])
}

// ── Hostel: rooms, menu, orders (HOSTEL workspaces only) ───────────────────

/// A bookable room type with a fixed nightly rate — context/01-project-
/// overview.md's `Property.rooms: String[]` is decorative free text with no
/// pricing/booking linkage; this is the real, priced entity HOSTEL bookings
/// reference via `Booking.roomId`.
model Room {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @db.Uuid
  propertyId    String   @db.Uuid
  name          String
  pricePerNight Decimal  @db.Decimal(10, 2)
  currency      Currency @default(GHS)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property  Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  issues    Issue[]

  @@index([workspaceId])
  @@index([propertyId])
}

/// One row per dish/drink on the master menu. `category` is free text
/// (e.g. "Breakfast", "Drinks", "Lunch & Dinner" for Escape3Points) rather
/// than an enum — menu structure is workspace-specific, not a fixed MNGO
/// concept. Most of a menu doesn't change day to day (breakfast, drinks,
/// the all-day menu) — `alwaysAvailable` marks those so staff don't have
/// to re-toggle them daily; only the genuinely rotating items (e.g. lunch
/// and dinner mains) rely on `isAvailableToday`, the live toggle staff use
/// on the Kitchen screen. An item is orderable when EITHER is true — see
/// lib/orders.ts createGuestOrder. No historical per-date availability
/// tracking in V1.
model MenuItem {
  id               String      @id @default(uuid()) @db.Uuid
  workspaceId      String      @db.Uuid
  name             String
  category         String
  price            Decimal     @db.Decimal(10, 2)
  currency         Currency    @default(GHS)
  alwaysAvailable  Boolean     @default(false)
  isAvailableToday Boolean     @default(false)
  /// Which of the Kitchen/Bar screens this item's orders show up on.
  station          MenuStation @default(KITCHEN)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([workspaceId])
}

/// A guest's order against their stay — one Booking can have many Orders
/// (e.g. one per day or per sitting). `kitchenStatus`/`barStatus`/
/// `shopStatus`/`experienceStatus` are independent (reusing IssueStatus —
/// OPEN/IN_PROGRESS/RESOLVED, shown as Received/Preparing/Delivered): set
/// at creation to OPEN if the order has any item for that station, else
/// left null, so an order spanning multiple stations gets one
/// independently-tracked ticket per station without one's progress
/// affecting another's (Architecture Decision 91 added shopStatus/
/// experienceStatus alongside the original kitchenStatus/barStatus).
/// Soft-deletable (deletedAt/deletedBy/deleteReason) — a deleted order
/// drops out of the guest's bill and the fulfillment screens but stays
/// queryable for the owner (app/api/orders/[id]/route.ts DELETE). A
/// CO_MANAGER's delete is a pending request (deleteRequestedAt/By set,
/// deletedAt still null) until the ACCOUNT_OWNER approves or rejects it —
/// same mechanism as Booking, see its doc comment (Architecture Decision 99).
model Order {
  id                String       @id @default(uuid()) @db.Uuid
  workspaceId       String       @db.Uuid
  bookingId         String       @db.Uuid
  kitchenStatus     IssueStatus?
  barStatus         IssueStatus?
  shopStatus        IssueStatus?
  experienceStatus  IssueStatus?
  deletedAt         DateTime?
  deletedBy         String?
  deleteReason      String?
  deleteRequestedAt DateTime?
  deleteRequestedBy String?
  createdAt         DateTime     @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  booking   Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@index([workspaceId])
  @@index([bookingId])
}

/// `name`/`unitPrice`/`currency`/`station` are snapshotted from MenuItem
/// at order time so a later menu edit (price change or reclassifying
/// which station prepares it) never rewrites a guest's past bill or which
/// screen a historical order appeared on. `menuItemId` is nullable with
/// `onDelete: SetNull` (Architecture Decision 91) — a real production bug
/// found while reseeding the menu: the FK was previously required with no
/// cascade, so `DELETE /api/menu/[id]` on any item that had ever actually
/// been ordered failed with a raw foreign-key-violation 500, contradicting
/// this doc comment's own claim that past orders are "unaffected." The
/// snapshot fields above are what make an OrderItem meaningful once
/// `menuItemId` is null — nothing reads it back off an existing order.
model OrderItem {
  id         String      @id @default(uuid()) @db.Uuid
  orderId    String      @db.Uuid
  menuItemId String?     @db.Uuid
  name       String
  quantity   Int
  unitPrice  Decimal     @db.Decimal(10, 2)
  currency   Currency
  station    MenuStation @default(KITCHEN)
  createdAt  DateTime    @default(now())

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
}

// ── Financials ───────────────────────────────────────────────────────────

/// context/01-project-overview.md "Financials". GHS expenses get the 1%
/// MoMo charge applied at read time (lib/financials.ts), never stored.
model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  propertyId  String          @db.Uuid
  date        DateTime        @db.Date
  description String
  amount      Decimal         @db.Decimal(10, 2)
  currency    Currency
  category    ExpenseCategory
  person      String?
  createdAt   DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property  Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([propertyId])
}

/// Manual income entries — owner contributions, top-ups.
/// context/01-project-overview.md "Financials".
model ManualIncome {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  propertyId  String   @db.Uuid
  date        DateTime @db.Date
  description String
  amount      Decimal  @db.Decimal(10, 2)
  currency    Currency
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property  Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([propertyId])
}

// ── Issues & Schedules ───────────────────────────────────────────────────

/// context/01-project-overview.md "Issues & Schedules".
/// `status` reuses the IssueStatus enum (OPEN/IN_PROGRESS/RESOLVED) rather
/// than a duplicate — same three-state lifecycle, user decision 2026-08-01:
/// schedules need "some status... just like the way the status for the
/// issues." A schedule starts OPEN and gets closed out (RESOLVED) with an
/// optional note on how it went, same mechanism as Issue/IssueStatusEvent.
model Schedule {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  propertyId  String       @db.Uuid
  type        ScheduleType
  date        DateTime     @db.Date
  assignedTo  String
  note        String?
  status      IssueStatus  @default(OPEN)
  createdAt   DateTime     @default(now())

  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property      Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  statusHistory ScheduleStatusEvent[]

  @@index([workspaceId])
  @@index([propertyId])
}

model ScheduleStatusEvent {
  id         String      @id @default(uuid()) @db.Uuid
  scheduleId String      @db.Uuid
  status     IssueStatus
  /// Free-text note on how the task went — user decision 2026-08-01: "write
  /// notes on how they did it and then also close it."
  note       String?
  at         DateTime    @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

/// Every status change is timestamped and stored in `statusHistory`.
/// context/01-project-overview.md "Issues & Schedules". `status` is
/// nullable: NOTE-type issues are informational only and never enter the
/// Open/In Progress/Resolved lifecycle — context/07-mockup.jsx IssueForm:
/// `status: type === 'Note' ? null : 'Open'`. GUEST_COMPLAINT and
/// MAINTENANCE always start at OPEN.
model Issue {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  propertyId  String       @db.Uuid
  date        DateTime     @db.Date
  type        IssueType
  description String
  guest       String?
  /// HOSTEL only — set when auto-created by checkout (ROOM_DIRTY), so the
  /// issue is tied to a specific room, not just described in free text.
  roomId      String?      @db.Uuid
  status      IssueStatus?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property      Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room          Room?              @relation(fields: [roomId], references: [id])
  statusHistory IssueStatusEvent[]

  @@index([workspaceId])
  @@index([propertyId])
  @@index([roomId])
}

model IssueStatusEvent {
  id      String      @id @default(uuid()) @db.Uuid
  issueId String      @db.Uuid
  status  IssueStatus
  /// Free-text note on a status change — user decision 2026-08-01: "for the
  /// issues, there's also supposed to be some notes."
  note    String?
  at      DateTime    @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

// ── Team ─────────────────────────────────────────────────────────────────

/// context/01-project-overview.md "Properties and Team". Payment history is
/// derived from Expense rows where category = MANAGEMENT and person = name
/// — there is no separate payments table (matches context/07-mockup.jsx
/// TeamMemberDetail, which reads history straight off expenses).
model TeamMember {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  role        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ── Security ─────────────────────────────────────────────────────────────

/// Lightweight IP-scoped throttle for unauthenticated endpoints prone to
/// abuse (guest /track "login", public workspace /signup) — see
/// lib/rate-limit.ts. Best-effort under concurrent requests (no row
/// locking), which is fine for a security throttle, unlike anything
/// financial. No external rate-limiting service in the stack, so this
/// reuses the existing Postgres connection instead of adding one.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}
